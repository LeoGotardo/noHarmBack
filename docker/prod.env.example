# cp prod.env.example prod.env and fill in. prod.env is gitignored.
#
# This file is for the compose.prod.yaml path — one host, nginx holding the
# certificate. On ECS none of it is used: the values live in the task
# definition (infra/ecs.tf) and in Secrets Manager, and the ones marked
# "composed" below are derived at boot by docker/entrypoint.sh.
#
# config.py raises on the first missing required key and the container exits
# before nginx answers, so an incomplete file fails loudly at boot.

# ── Runtime shape ───────────────────────────────────────────────────────────
EXEC_MODE=prod
DEBUG=false
PORT=8080

# ── Database ────────────────────────────────────────────────────────────────
# Either set DATABASE_URL and DATABASE_URL_UNPOOLED as full strings, or set the
# parts and let the entrypoint compose them (which is what ECS does, so that
# the RDS-managed password is never copied anywhere).
#
# UNPOOLED must bypass any pooler: alembic runs DDL, and pgBouncer/RDS Proxy
# break it. Same host as the other when there is no pooler.
DATABASE_HOST=noharm-prod.abcdefgh.us-east-1.rds.amazonaws.com
DATABASE_PORT=5432
DATABASE_NAME=noharm
DATABASE_USER=noharm
DATABASE_PASSWORD=
DATABASE_SSLMODE=require
# DATABASE_HOST_UNPOOLED=   # only when a pooler fronts DATABASE_HOST
# DATABASE_URL=             # set both or neither
# DATABASE_URL_UNPOOLED=

# Column-level key for the data the database itself must not be able to read.
# LOSING THIS MAKES EVERY ENCRYPTED FIELD UNREADABLE — there is no recovery
# path, and rotating it means re-encrypting every row.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATABASE_ENCRYPTION_KEY=
ENCRYPTION_KEY=

# Key for the blind indexes — the columns that make an encrypted username,
# e-mail or FCM token findable by exact match (cl_0b_h, cl_0c_h, cl_9c_h).
#
# Must NOT equal DATABASE_ENCRYPTION_KEY. The index sits in the same row as the
# ciphertext it indexes, so a single key protecting both is one leak, not two.
# It was an unkeyed SHA-256 until 20260902_01, which meant reading the database
# was enough to recover every e-mail from a wordlist — no key required at all.
#
# Changing it invalidates every stored index (lookups miss, and a login by
# e-mail looks like "no such user") until 20260902_01 is re-run to recompute
# them. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BLIND_INDEX_KEY=

# ── Redis ───────────────────────────────────────────────────────────────────
# Not a cache: JWT blacklist, rate-limit buckets and the Socket.IO fan-out.
# rediss:// when the endpoint has transit encryption (ElastiCache does here).
REDIS_URL=rediss://noharm-prod.abcdef.ng.0001.use1.cache.amazonaws.com:6379/0

# ── JWT ─────────────────────────────────────────────────────────────────────
# Two distinct keys. Reusing one makes a refresh token accepted as an access
# token, which turns a 7-day credential into a 15-minute one's authority.
#   python -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Firebase ────────────────────────────────────────────────────────────────
# The service account JSON, on one line. Without it every login and every
# registration fails — the backend verifies Firebase ID tokens with it.
# FIREBASE_AUTH_EMULATOR_HOST must NOT be set: the entrypoint refuses to start
# if it is, because it disables token verification entirely.
FIREBASE_SERVICE_ACCOUNT=

# ── CORS ────────────────────────────────────────────────────────────────────
# The web bundle is same-origin with the API and needs no entry here. The
# Capacitor app is the only cross-origin client, and it presents these two
# origins — drop them and mobile REST breaks while the socket keeps working,
# which reads like anything but a CORS problem.
ALLOWED_ORIGINS=["https://app.example.com","capacitor://localhost","http://localhost"]

# ── Status codes ────────────────────────────────────────────────────────────
# Shared with the front-end's VITE_STATUS_CONSTANTS. They must agree.
STATUS_CODES={"disabled":0,"enabled":1,"deleted":2,"blocked":3,"pending":4,"accepted":5,"ignored":6,"unread":7,"read":8,"banned":9}

# ── Account deletion (optional, default shown) ──────────────────────────────
# Days a soft-deleted account is kept before `purge-accounts` destroys it for
# good. The user can restore it by signing in during this window, and the delete
# confirmation screen states the number — change it here and change it there.
# 0 makes every deletion eligible on the next purge run, i.e. a hard delete.
# ACCOUNT_DELETION_GRACE_DAYS=30

# ── Report evidence retention (optional, default 180) ───────────────────────
# How long the copy taken with a report — the reported profile, and the messages
# of the conversation it named — is kept after a moderator closed that report.
# The report itself is permanent; this is only the copied prose, which is two
# users' private correspondence held for one purpose. Swept by the
# `purge-evidence` cron (docs/operations.md); an open report is never swept.
# REPORT_EVIDENCE_RETENTION_DAYS=180

# ── Moderation windows (optional, defaults shown) ───────────────────────────
# Longest suspension PUT /users/{id}/suspend will set. Past this the honest
# action is a permanent ban, which someone has to choose rather than arrive at
# by typing a large number of days.
# MAX_SUSPENSION_DAYS=365
#
# How long a moderator's claim on a report holds before anyone may take it. An
# expiring lock is the difference between a queue that heals itself and one
# that fills with reports parked by someone who closed the tab.
# REPORT_LOCK_MINUTES=30

# ── Report abuse ceilings (optional, defaults shown) ────────────────────────
# The rate limit on POST /reports/{userId} keys on the client IP. One account
# reporting a different person every twelve seconds never trips it, and a
# reporter behind a shared mobile NAT trips it because of strangers. These key
# on the reporter instead.
#
# Per-account quota, charged only on reports that were actually filed. Two
# windows, because an hourly cap alone permits 240 a day at a steady drip and a
# daily cap alone permits the whole allowance in one burst.
# REPORT_MAX_PER_HOUR=10
# REPORT_MAX_PER_DAY=30
#
# How many of one account's reports may sit unreviewed at once. The quota limits
# the rate; this limits the standing backlog, so one reporter cannot occupy the
# queue while moderators work through it. Every report a moderator closes frees
# a slot.
# REPORT_MAX_OPEN=5
#
# After a moderator dismisses a report, how long before the same reporter may
# file about the same person again. Without it, "dismissed" is a round trip. A
# report that was *actioned* is never cooled down — repeat offending is the case
# you want to hear about immediately.
# REPORT_DISMISSED_COOLDOWN_DAYS=30
#
# How many open reports by distinct accounts against one user make the queue say
# "this looks coordinated". A flag for a human and nothing else: acting on a
# count is precisely what a brigade is buying.
# REPORT_BRIGADING_THRESHOLD=5

# ── Admin (optional, default empty) ─────────────────────────────────────────
# Firebase UIDs allowed to call the moderation routes: PUT /users/{id}/status/
# {status} — which bans, unbans and undeletes — plus the report queue,
# GET /reports/{id}/evidence and the resolutions. There is no role column and no
# admin UI: this list is the entire authorisation model. Everyone named here can
# read the private messages captured with any report, so name people, not teams.
# Empty means nobody can reach any of it, which is the right setting until there
# is a named administrator. JSON array.
# ADMIN_USER_IDS=["<firebase-uid>"]

# ── Rate limiting (optional, defaults shown) ────────────────────────────────
# Global IP floor. Per-route slowapi limits are the real ceilings.
# RATE_LIMIT_MAX_REQUESTS=240
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_BLOCK_SECONDS=60
# RATE_LIMIT_MAX_BLOCK_SECONDS=900
